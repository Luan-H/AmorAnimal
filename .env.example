# Exemplo de configuração de ambiente (.env)
# Preencha com os dados da sua conta gratuita do Cloudinary (cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase: Coloque o arquivo de credenciais firebase_credentials.json na raiz do projeto
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
